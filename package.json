{
  "name": "agent-usage",
  "version": "0.1.0",
  "description": "Local Claude Code + Codex usage analytics by Git repository/project",
  "license": "MIT",
  "type": "module",
  "author": "michaelmang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelmang/agent-usage.git"
  },
  "bugs": {
    "url": "https://github.com/michaelmang/agent-usage/issues"
  },
  "homepage": "https://github.com/michaelmang/agent-usage#readme",
  "keywords": [
    "claude",
    "codex",
    "ccusage",
    "usage",
    "tokens",
    "cli",
    "sqlite"
  ],
  "bin": {
    "agent-usage": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.json && node dist/cli.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "ccusage": "^20.0.20",
    "commander": "^13.1.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
